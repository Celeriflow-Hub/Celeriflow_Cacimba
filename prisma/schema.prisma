// --- Tributário S3: ITBI e Domicílio Tributário Eletrônico ---
// Os IDs abaixo apontam para os cadastros globais e são validados pelo serviço
// do módulo. As relações internas do S3 permanecem explícitas e auditáveis.
model ItbiTransactionType {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  rate                  Decimal  @db.Decimal(9, 6)
  damStage              String   @default("APROVACAO")
  cadastralUpdateMode   String   @default("MANUAL")
  requiresDebtClearance Boolean  @default(true)
  isActive              Boolean  @default(true)
  legalBasis            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  declarations ItbiDeclaration[]
}

model ItbiDeclaration {
  id                    String              @id @default(cuid())
  declarationNumber     String              @unique
  status                String              @default("RASCUNHO")
  transactionTypeId     String
  transactionType       ItbiTransactionType @relation(fields: [transactionTypeId], references: [id], onDelete: Restrict)
  realEstateId          String
  processId             String?
  protocolNumber        String?
  registryOffice        String?
  transmissionScope     String              @default("INTEGRAL")
  transmittedFraction   Decimal             @db.Decimal(9, 6)
  declaredPropertyValue Decimal             @db.Decimal(18, 2)
  taxableBase           Decimal             @db.Decimal(18, 2)
  appliedRate           Decimal             @db.Decimal(9, 6)
  taxAmount             Decimal             @db.Decimal(18, 2)
  calculationSnapshot   Json
  blockingTaxDebt       Decimal             @default(0) @db.Decimal(18, 2)
  nonTaxDebtAmount      Decimal             @default(0) @db.Decimal(18, 2)
  isLeasehold           Boolean             @default(false)
  leaseholdDetails      String?
  cadastralUpdateMode   String              @default("MANUAL")
  cadastralUpdatedAt    DateTime?
  assessmentId          String?
  guideId               String?
  documentId            String?
  analysisNotes         String?
  analyzedAt            DateTime?
  createdByUsuarioId    String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  parties ItbiParty[]
  events  ItbiEvent[]

  @@index([realEstateId, status])
  @@index([processId])
  @@index([assessmentId])
  @@index([guideId])
}

model ItbiParty {
  id                   String          @id @default(cuid())
  declarationId        String
  declaration          ItbiDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  taxpayerId           String
  role                 String
  participationPercent Decimal?        @db.Decimal(9, 6)
  liabilityType        String?
  sortOrder            Int             @default(0)
  createdAt            DateTime        @default(now())

  @@index([declarationId, role, sortOrder])
  @@index([taxpayerId])
}

model ItbiEvent {
  id             String          @id @default(cuid())
  declarationId  String
  declaration    ItbiDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  eventType      String
  description    String
  payload        Json?
  actorUsuarioId String
  createdAt      DateTime        @default(now())

  @@index([declarationId, createdAt])
}

model DteMailbox {
  id                    String    @id @default(cuid())
  taxpayerId            String
  establishmentCnpj     String?
