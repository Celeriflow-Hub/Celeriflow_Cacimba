  @@index([configuracaoInstanciaId, status, effectiveFrom])
}

model HrPayrollRule {
  id             String           @id @default(cuid())
  ruleSetId      String
  ruleSet        HrPayrollRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category       String
  code           String
  name           String
  description    String?
  valueType      String
  value          Json
  unit           String?
  sortOrder      Int              @default(100)
  legalReference String?
  isRequired     Boolean          @default(false)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([ruleSetId, code])
  @@index([ruleSetId, category, sortOrder])
