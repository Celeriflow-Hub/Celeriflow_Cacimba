// Cross-cutting, payload-free evidence for successful authenticated operations.
// The database trigger created by the migration makes these records append-only.
model AuditEvent {
  id             String   @id @default(cuid())
  eventType      String
  targetType     String
  targetId       String
  actorUsuarioId String
  actorUsuario   Usuario  @relation("AuditEventActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorUsuarioId, createdAt])
  @@index([eventType, createdAt])
  @@index([targetType, targetId, createdAt])
}

// A deliberately redacted, independently validated public projection. Source records remain private.
model PublicNotice {
  id                   String   @id @default(cuid())
  sourceModule         String
  sourceEntityId       String
  title                String
  category             String
  publishedAt          DateTime @default(now())
  validationCode       String   @unique
  publishedByUsuarioId String
  publishedByUsuario   Usuario  @relation("PublicNoticePublisher", fields: [publishedByUsuarioId], references: [id], onDelete: Restrict)

  @@unique([sourceModule, sourceEntityId])
  @@index([publishedAt])
}

// Mutable workflow state for an approved PF-only duplicate merge.
model PersonMergeRequest {
  id                  String    @id @default(cuid())
  status              String    @default("PROPOSED") // PROPOSED, EXECUTED, REVERSED
  sourcePersonId      String
  sourcePerson        Person    @relation("PersonMergeSource", fields: [sourcePersonId], references: [id], onDelete: Restrict)
  targetPersonId      String
  targetPerson        Person    @relation("PersonMergeTarget", fields: [targetPersonId], references: [id], onDelete: Restrict)
  proposedByUsuarioId String
  proposedByUsuario   Usuario   @relation("PersonMergeProposer", fields: [proposedByUsuarioId], references: [id], onDelete: Restrict)
  approvedByUsuarioId String?
  approvedByUsuario   Usuario?  @relation("PersonMergeApprover", fields: [approvedByUsuarioId], references: [id], onDelete: Restrict)
  reversedByUsuarioId String?
  reversedByUsuario   Usuario?  @relation("PersonMergeReverser", fields: [reversedByUsuarioId], references: [id], onDelete: Restrict)
  approvedAt          DateTime?
  executedAt          DateTime?
  reversedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ledger PersonMergeLedger[]

  @@index([status, createdAt])
  @@index([sourcePersonId])
  @@index([targetPersonId])
}

// Immutable identifier-only evidence and manifest of every merge state transition.
model PersonMergeLedger {
  id             String             @id @default(cuid())
  requestId      String
  request        PersonMergeRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  eventType      String // PROPOSED, EXECUTED, REVERSED
  sourcePersonId String
  sourcePerson   Person             @relation("PersonMergeLedgerSource", fields: [sourcePersonId], references: [id], onDelete: Restrict)
  targetPersonId String
  targetPerson   Person             @relation("PersonMergeLedgerTarget", fields: [targetPersonId], references: [id], onDelete: Restrict)
  actorUsuarioId String
  actorUsuario   Usuario            @relation("PersonMergeLedgerActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)
  manifest       Json
  createdAt      DateTime           @default(now())

  @@index([requestId, createdAt])
  @@index([sourcePersonId, createdAt])
  @@index([targetPersonId, createdAt])
}

