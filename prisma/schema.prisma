model AssetValueHistory {
  id             String   @id @default(cuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id])
  referenceMonth DateTime
  openingValue   Float
  depreciation   Float
  closingValue   Float
  lifeSpanMonths Int
  createdAt      DateTime @default(now())

  @@unique([assetId, referenceMonth])
  @@index([referenceMonth])
}

model AssetTransfer {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  reason String?
  status String   @default("Aprovada")

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  fromDepartmentId String?
  fromDepartment   Department? @relation("TransferFromDept", fields: [fromDepartmentId], references: [id])
  toDepartmentId   String?
  toDepartment     Department? @relation("TransferToDept", fields: [toDepartmentId], references: [id])

  fromResponsibleId String?
  fromResponsible   Employee? @relation("TransferFromResp", fields: [fromResponsibleId], references: [id])
  toResponsibleId   String?
  toResponsible     Employee? @relation("TransferToResp", fields: [toResponsibleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetMaintenance {
  id                  String          @id @default(cuid())
  description         String
  cost                Float?
  status              String          @default("Solicitada") // Solicitada, Em manutenÃ§Ã£o, ConcluÃ­da
  startDate           DateTime        @default(now())
  endDate             DateTime?
  fleetPreviousStatus String?
  fleetOrder          FleetWorkOrder?

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  supplierId String?
  supplier   Supplier? @relation("AssetMaintenanceSupplier", fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetWriteOff {
  id                      String                 @id @default(cuid())
  date                    DateTime               @default(now())
  type                    String                 @default("Baixa") // Baixa, AlienaÃ§Ã£o
  reason                  String // InservÃ­vel, Roubo, DoaÃ§Ã£o
  justification           String
  status                  String                 @default("Aprovada")
  disposalValue           Float                  @default(0)
  bookValue               Float
  gainLoss                Float
  accountingTransactionId String?                @unique
  accountingTransaction   AccountingTransaction? @relation("AssetWriteOffAccountingTransaction", fields: [accountingTransactionId], references: [id])

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrationPending AssetIntegrationPendingConfiguration?
}

model AssetValueAdjustment {
  id              String   @id @default(cuid())
  type            String // REVALUATION, IMPAIRMENT, SUBSEQUENT_COST
  date            DateTime
  openingValue    Float
  adjustmentValue Float
  closingValue    Float
  justification   String
  evidence        String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId, date])
}

// This is evidence of a missing configuration, never a substitute financial record.
model AssetIntegrationPendingConfiguration {
  id                String        @id @default(cuid())
  assetWriteOffId   String        @unique
  assetWriteOff     AssetWriteOff @relation(fields: [assetWriteOffId], references: [id], onDelete: Restrict)
  expectedEventCode String
  reason            String
  status            String        @default("PENDING_CONFIGURATION")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// Almoxarifado
model Warehouse {
