model Patient {
  id             String   @id @default(cuid())
  cns            String?  @unique
  bloodType      String?
  bloodDonor     Boolean?
  knownAllergies String?
  specialNeeds   String?
  status         String   @default("Ativo") // Ativo, Inativo, Falecido

  personId String @unique
  person   Person @relation("PersonPatient", fields: [personId], references: [id])

  referenceUnitId String?
  referenceUnit   HealthUnit? @relation(fields: [referenceUnitId], references: [id], onDelete: Restrict)

  teamId String?
  team   HealthTeam? @relation(fields: [teamId], references: [id], onDelete: Restrict)

  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments                HealthAppointment[]
  records                     MedicalRecord[]
  prescriptions               HealthPrescription[]
  dispensations               MedicineDispensation[]
  vaccinations                VaccinationRecord[]
  examRequests                HealthExamRequest[]
  referrals                   HealthReferral[]
  healthLabOrders             HealthLabOrder[]
  specializedPlans            SpecializedTherapeuticPlan[]
  specializedQuotas           SpecializedQuota[]
  specializedDistributions    SpecializedDistribution[]
  pharmacyRequests            PharmacyRequest[]
  healthRegulationRequests    HealthRegulationRequest[]
  healthTfdRequests           HealthTfdRequest[]
  healthTfdPassengers         HealthTfdPassenger[]
  healthProductionFacts       HealthProductionFact[]
  healthHomeVisitParticipants HealthHomeVisitParticipant[]
  healthEsusForms             HealthEsusForm[]
  healthWaitlists             HealthWaitlist[]
  healthReceptions            HealthReception[]
  healthBedOccupancies        HealthBedOccupancy[]
  healthObservations          HealthObservation[]
}

model HealthProfessional {
  id                          String    @id @default(cuid())
  cbo                         String?
  cns                         String?
  councilName                 String? // CRM, COREN, CRO
  councilNumber               String?
  specialty                   String?
  treatment                   String?
  isAuditor                   Boolean   @default(false)
  consultationIntervalMinutes Int?
  isActive                    Boolean   @default(true)
  inactivatedAt               DateTime?
  inactivationReason          String?

  employeeId String   @unique
  employee   Employee @relation("EmployeeHealthProfessional", fields: [employeeId], references: [id])

  unitId String?
  unit   HealthUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)

  teamId String?
  team   HealthTeam? @relation(fields: [teamId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments               HealthAppointment[]
  records                    MedicalRecord[]
  triages                    HealthTriage[]
  evolutions                 HealthClinicalEvolution[]
  performedProcedures        HealthPerformedProcedure[]
  prescriptions              HealthPrescription[]
  vaccinations               VaccinationRecord[]
  examRequests               HealthExamRequest[]
  referrals                  HealthReferral[]
  assignments                HealthProfessionalAssignment[]
  serviceAssignments         HealthServiceAssignment[]         @relation("HealthProfessionalServiceAssignments")
  habilitations              HealthHabilitation[]              @relation("HealthProfessionalHabilitations")
  statusHistory              HealthRegistrationStatusHistory[] @relation("HealthProfessionalStatusHistory")
  medicineDispensations      MedicineDispensation[]
  healthLabCollections       HealthLabOrder[]                  @relation("HealthLabOrderCollector")
  healthLabReviews           HealthLabReport[]                 @relation("HealthLabReportReviewer")
  specializedPlanEntries     SpecializedPlanEntry[]
  healthRegulationRequests   HealthRegulationRequest[]
  healthProductionFacts      HealthProductionFact[]
  healthMicroareas           HealthMicroarea[]
  healthHomeVisits           HealthHomeVisit[]
  healthEsusForms            HealthEsusForm[]
  healthVigilanceInspections HealthVigilanceInspection[]
  healthCareSchedules        HealthCareSchedule[]

  @@index([cns])
}

model HealthTeam {
  id        String  @id @default(cuid())
  name      String
  code      String? @unique
  microarea String?
  isActive  Boolean @default(true)

  unitId String
  unit   HealthUnit @relation(fields: [unitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionals        HealthProfessional[]
  patients             Patient[]
  specializedSchedules SpecializedTeamSchedule[]
  specializedPlans     SpecializedTherapeuticPlan[]
  healthTerritoryAreas HealthTerritoryArea[]
  healthHomeVisits     HealthHomeVisit[]
  healthEsusForms      HealthEsusForm[]
}

model HealthAppointment {
  id                   String    @id @default(cuid())
  date                 DateTime
  specialty            String?
  origin               String    @default("SCHEDULED")
  priority             String    @default("Normal") // Normal, Prioridade, UrgÃªncia
  status               String    @default("Agendado") // Agendado, Aguardando, Em Atendimento, Atendido, Faltou, Cancelado
  cancelledAt          DateTime?
  cancellationReason   String?
  confirmedAt          DateTime?
  arrivedAt            DateTime?
  triagedAt            DateTime?
  calledAt             DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  arrivalNotes         String?
  municipalitySnapshot String?
  stateSnapshot        String?
  outcome              String?
  sequence             Int       @default(0)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  unitId String
  unit   HealthUnit @relation(fields: [unitId], references: [id])

  professionalId String?
  professional   HealthProfessional? @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  schedulingGroupId String?
  schedulingGroup   HealthSchedulingGroup? @relation(fields: [schedulingGroupId], references: [id], onDelete: Restrict)

  specialtyId  String?
  specialtyRef HealthSpecialty? @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  serviceId String?
  service   HealthService? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  scheduleId String?
  schedule   HealthCareSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  visitType String? // Primeira, Retorno, Avaliação

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecord MedicalRecord?
  triage        HealthTriage?
  events        HealthAppointmentEvent[]

  @@index([unitId, date])
  @@index([professionalId, date])
  @@index([patientId, date])
  @@index([origin, status, date])
  @@index([schedulingGroupId, date])
  @@index([specialtyId, date])
}

model HealthAppointmentEvent {
  id             String            @id @default(cuid())
  appointmentId  String
  appointment    HealthAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  eventType      String
  fromStatus     String?
  toStatus       String?
  notes          String?
  actorUsuarioId String
  actorUsuario   Usuario           @relation("HealthAppointmentEventActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)
  occurredAt     DateTime          @default(now())

  @@index([appointmentId, occurredAt])
  @@index([eventType, occurredAt])
}

model HealthTriage {
  id                 String             @id @default(cuid())
  appointmentId      String             @unique
  appointment        HealthAppointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  professionalId     String
  professional       HealthProfessional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  chiefComplaint     String
  bloodPressure      String?
  temperature        Float?
  weight             Float?
  height             Float?
  heartRate          Int?
  respiratoryRate    Int?
  oxygenSaturation   Float?
  bloodGlucose       Float?
  observedConditions String?
  riskClassification String
  priorityLabel      String
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([riskClassification, createdAt])
  @@index([professionalId, createdAt])
}

model MedicalRecord {
  id   String   @id @default(cuid())
  date DateTime @default(now())
  type String   @default("Consulta") // Consulta, Triagem, Procedimento

  // Triagem / Sinais vitais
  bloodPressure    String?
  temperature      Float?
  weight           Float?
  height           Float?
  heartRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?
  bloodGlucose     Float?

  // EvoluÃ§Ã£o clÃ­nica
  chiefComplaint String?
  anamnesis      String?
  assessment     String?
  evolution      String?
  conduct        String?
  observations   String?
  outcome        String?
  completedAt    DateTime?

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  professionalId String
  professional   HealthProfessional @relation(fields: [professionalId], references: [id])

  unitId String
  unit   HealthUnit @relation(fields: [unitId], references: [id])

  appointmentId String?            @unique
  appointment   HealthAppointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  diagnoses          HealthDiagnosis[]
  prescriptions      HealthPrescription[]
  examRequests       HealthExamRequest[]
  procedures         HealthPerformedProcedure[]
  referrals          HealthReferral[]
  evolutions         HealthClinicalEvolution[]
  clinicalDocuments  HealthClinicalDocument[]
  specializedPlans   SpecializedTherapeuticPlan[]
  specializedEntries SpecializedPlanEntry[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  healthEsusForms HealthEsusForm[]
}

model HealthClinicalEvolution {
  id              String             @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord      @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  professionalId  String
  professional    HealthProfessional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  content         String
  createdAt       DateTime           @default(now())

  @@index([medicalRecordId, createdAt])
}

model HealthDiagnosis {
  id              String             @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord      @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  cidReferenceId  String
  cidReference    HealthSusReference @relation(fields: [cidReferenceId], references: [id], onDelete: Restrict)
  isPrimary       Boolean            @default(false)
  notes           String?
  createdAt       DateTime           @default(now())

  @@unique([medicalRecordId, cidReferenceId])
  @@index([cidReferenceId, createdAt])
}

model HealthPerformedProcedure {
  id              String             @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord      @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  procedureId     String
  procedure       HealthSusProcedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  professionalId  String
  professional    HealthProfessional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  quantity        Int                @default(1)
  notes           String?
  performedAt     DateTime           @default(now())

  @@index([medicalRecordId, performedAt])
  @@index([procedureId, performedAt])
}

model HealthClinicalDocument {
  id               String        @id @default(cuid())
  medicalRecordId  String
  medicalRecord    MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  documentId       String        @unique
  document         Document      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  kind             String
  addedByUsuarioId String
  addedByUsuario   Usuario       @relation("HealthClinicalDocumentAddedBy", fields: [addedByUsuarioId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())

  @@index([medicalRecordId, kind, createdAt])
}

model Medicine {
  id              String  @id @default(cuid())
  name            String
  activePrinciple String?
  presentation    String? // Comprimido, Xarope
  concentration   String? // 500mg
  isControlled    Boolean @default(false)
  currentStock    Int     @default(0)
  minStock        Int     @default(0)
  isActive        Boolean @default(true)

  materialId String?   @unique
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispensations      MedicineDispensation[]
  batches            MedicineBatch[]
  prescriptionItems  HealthPrescriptionItem[]
  interactionOrigins MedicineInteraction[]    @relation("MedicineInteractionOrigin")
  interactionTargets MedicineInteraction[]    @relation("MedicineInteractionTarget")
  dosageTemplates    MedicineDosageTemplate[]
}

model MedicineInteraction {
  id               String   @id @default(cuid())
  originMedicineId String
  originMedicine   Medicine @relation("MedicineInteractionOrigin", fields: [originMedicineId], references: [id], onDelete: Restrict)
  targetMedicineId String
  targetMedicine   Medicine @relation("MedicineInteractionTarget", fields: [targetMedicineId], references: [id], onDelete: Restrict)
  description      String
  severity         String?
  source           String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([originMedicineId, targetMedicineId])
}

model MedicineDosageTemplate {
  id           String   @id @default(cuid())
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  name         String
  dose         String
  route        String?
  frequency    String
  duration     String?
  instructions String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([medicineId, name])
}

model HealthPrescription {
  id         String    @id @default(cuid())
  date       DateTime  @default(now())
  content    String // Detalhes da prescriÃ§Ã£o
  validUntil DateTime?

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  professionalId String
  professional   HealthProfessional @relation(fields: [professionalId], references: [id])

  unitId String?
  unit   HealthUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)

  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)

  items HealthPrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HealthPrescriptionItem {
  id             String                 @id @default(cuid())
  prescriptionId String
  prescription   HealthPrescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String?
  medicine       Medicine?              @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  medicineName   String
  presentation   String?
  dose           String
  route          String?
  frequency      String
  duration       String?
  quantity       Float?
  instructions   String?
  createdAt      DateTime               @default(now())
  dispensations  MedicineDispensation[]

  @@index([prescriptionId])
  @@index([medicineId])
}

model MedicineDispensation {
  id       String   @id @default(cuid())
  date     DateTime @default(now())
  quantity Float

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  unitId String
  unit   HealthUnit @relation(fields: [unitId], references: [id])

  batchId String?
  batch   MedicineBatch? @relation(fields: [batchId], references: [id])

  prescriptionItemId        String?
