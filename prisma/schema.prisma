  warehouseId        String
  warehouse          Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplierId         String?
  supplier           Supplier?                @relation("HealthStockReceiptSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
