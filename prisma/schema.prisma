// --- Tributário S6: ISS Bancário / DES-IF ---
// Os conceitos contábeis permanecem separados e versionados. Arquivos e
// assinaturas só são oficiais após configuração e homologação dos provedores.
model DesifFinancialInstitution {
  id         String    @id @default(cuid())
  taxpayerId String?
  name       String
