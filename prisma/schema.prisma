  inventorySession        InventorySession?        @relation("InventoryAdjustmentSession", fields: [inventorySessionId], references: [id])
  inventoryItem           InventorySessionItem?    @relation("InventoryItemAdjustment")
  healthReceiptItem       HealthStockReceiptItem?  @relation("HealthReceiptMovement")
  healthTransferDeparture HealthStockTransferItem? @relation("HealthTransferDeparture")
  healthTransferArrival   HealthStockTransferItem? @relation("HealthTransferArrival")
  medicineDispensation    MedicineDispensation?    @relation("MedicineDispensationMovement")
  vaccinationRecord       VaccinationRecord?       @relation("VaccinationMovement")
  specializedDistribution SpecializedDistribution? @relation("SpecializedDistributionMovement")

  createdAt DateTime @default(now())
