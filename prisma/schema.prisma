// LanÃ§amento TributÃ¡rio (DÃ­vida gerada para um contribuinte/imÃ³vel/empresa)
model TaxAssessment {
  id                     String    @id @default(cuid())
  year                   Int // ExercÃ­cio (Ex: 2026)
  originalValue          Float
  originalValueDecimal   Decimal?  @db.Decimal(18, 2)
  assessmentNumber       String?   @unique
  competence             DateTime?
  taxableBaseDecimal     Decimal?  @db.Decimal(18, 2)
  rate                   Decimal?  @db.Decimal(9, 6)
  discountValueDecimal   Decimal?  @db.Decimal(18, 2)
  interestValueDecimal   Decimal?  @db.Decimal(18, 2)
  penaltyValueDecimal    Decimal?  @db.Decimal(18, 2)
  correctionValueDecimal Decimal?  @db.Decimal(18, 2)
  finalValueDecimal      Decimal?  @db.Decimal(18, 2)
  calculationSnapshot    Json?
  status                 String    @default("LanÃ§ado") // LanÃ§ado, Emitido, Pago, DÃ­vida Ativa, Cancelado

  taxId String
  tax   Tax    @relation(fields: [taxId], references: [id])

  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])

  // Pode estar vinculado a um ImÃ³vel (IPTU) ou a um Cadastro EconÃ´mico (ISS/Taxas)
  realEstateId String?
  realEstate   RealEstate? @relation(fields: [realEstateId], references: [id])

  economicRegistrationId String?
  economicRegistration   EconomicRegistration? @relation(fields: [economicRegistrationId], references: [id])

  guides          TaxGuide[]
