model MaterialMovement {
  id               String            @id @default(cuid())
  type             String // Entrada, SaÃ­da, Ajuste
  quantity         Float
  unitValue        Float?
  date             DateTime          @default(now())
  reason           String? // Compra, Consumo, Vencimento
  fleetConsumption FleetConsumption?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  stockId String?
  stock   MaterialStock? @relation(fields: [stockId], references: [id])

  supplierId String?
  supplier   Supplier? @relation("MaterialMovementSupplier", fields: [supplierId], references: [id])

  departmentId String?
  department   Department? @relation("MovementDepartment", fields: [departmentId], references: [id])

  obrasServicoId String?
  obrasServico   ObrasServico? @relation(fields: [obrasServicoId], references: [id], onDelete: SetNull)

  settlementId String?
  settlement   Settlement? @relation("SettlementMaterialMovements", fields: [settlementId], references: [id], onDelete: Restrict)

  purchaseReceiptItem PurchaseReceiptItem? @relation("PurchaseReceiptItemMovement")
  assetAcquisition    Asset?               @relation("AssetAcquisitionMovement")

