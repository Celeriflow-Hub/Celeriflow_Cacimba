  purchaseProcessItems     PurchaseProcessItem[]
  receiptItems             PurchaseReceiptItem[]
  obrasServiceMaterials    ObrasServicoMaterial[]
  educationFoodMovements   EducationFoodMovement[]
  healthProfile            HealthMaterialProfile?
  medicine                 Medicine?
  vaccine                  Vaccine?
