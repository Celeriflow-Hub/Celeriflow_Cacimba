  fiscalCases DesifFiscalCase[]

  @@index([status, validFrom])
  @@index([taxpayerId])
}

model DesifAgency {
  id                     String                    @id @default(cuid())
  institutionId          String
  institution            DesifFinancialInstitution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
