model HealthSusImportBatch {
  id              String    @id @default(cuid())
  source          String
  competence      String
  origin          String
  fileName        String
  fileFormat      String
  contractVersion String
  checksum        String
  status          String    @default("PROCESSING")
  processedCount  Int       @default(0)
  insertedCount   Int       @default(0)
  updatedCount    Int       @default(0)
  ignoredCount    Int       @default(0)
  issueCount      Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  actorUsuarioId  String
  actorUsuario    Usuario   @relation("HealthSusImportBatchActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)

  issues     HealthSusImportIssue[]
  procedures HealthSusProcedure[]
  references HealthSusReference[]

  @@unique([source, competence, checksum])
  @@index([source, competence, startedAt])
  @@index([status, startedAt])
}

model HealthSusImportIssue {
  id         String               @id @default(cuid())
  batchId    String
  batch      HealthSusImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber  Int
  entityType String
  reason     String
  createdAt  DateTime             @default(now())

  @@index([batchId, rowNumber])
}

model HealthSusProcedure {
  id                       String                        @id @default(cuid())
  source                   String
  competence               String
  code                     String
  description              String
  groupCode                String?
  groupName                String?
  subgroupCode             String?
  subgroupName             String?
  complexity               String?
  registrationInstrument   String?
  unitValue                Decimal?                      @db.Decimal(14, 2)
  minimumAge               Int?
  maximumAge               Int?
  allowedSex               String?
  financing                String?
  cidCodes                 String?
  cboCodes                 String?
  serviceCodes             String?
  classificationCodes      String?
  isActive                 Boolean                       @default(true)
  isCurrent                Boolean                       @default(true)
  sourceBatchId            String
  sourceBatch              HealthSusImportBatch          @relation(fields: [sourceBatchId], references: [id], onDelete: Restrict)
  referenceLinks           HealthSusProcedureReference[]
  performedProcedures      HealthPerformedProcedure[]
  examRequests             HealthExamRequest[]
  labExamModels            HealthLabExamModel[]
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  healthRegulationQuotas   HealthRegulationQuota[]
  healthRegulationRequests HealthRegulationRequest[]
  healthProductionFacts    HealthProductionFact[]
  healthProductionTargets  HealthProductionTarget[]

  @@unique([sourceBatchId, code])
  @@index([code])
  @@index([description])
  @@index([source, competence, code, isCurrent])
  @@index([competence, isActive, isCurrent])
}

model HealthSusReference {
  id                       String                        @id @default(cuid())
  source                   String
  competence               String
  kind                     String
  code                     String
  description              String
  classification           String?
  isActive                 Boolean                       @default(true)
  isCurrent                Boolean                       @default(true)
  sourceBatchId            String
  sourceBatch              HealthSusImportBatch          @relation(fields: [sourceBatchId], references: [id], onDelete: Restrict)
  procedureLinks           HealthSusProcedureReference[]
  diagnoses                HealthDiagnosis[]
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  healthProductionFacts    HealthProductionFact[]
  healthRegulationRequests HealthRegulationRequest[]

  @@unique([sourceBatchId, kind, code])
  @@index([source, competence, kind, code, isCurrent])
  @@index([description])
  @@index([competence, isActive, isCurrent])
}

model HealthSusProcedureReference {
  id           String             @id @default(cuid())
  procedureId  String
  procedure    HealthSusProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  referenceId  String
  reference    HealthSusReference @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  relationType String
  createdAt    DateTime           @default(now())

  @@unique([procedureId, referenceId, relationType])
  @@index([referenceId, relationType])
}

model HealthStandardDocument {
