  publicityCampaignName String?
  fundedDebtName        String?
  reservationId         String?             @unique
  reservation           BudgetReservation?  @relation(fields: [reservationId], references: [id])
  status                String              @default("Emitido") // Emitido, Liquidado, Pago, Anulado
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  settlements          Settlement[]
  payments             Payment[]
  financialDocument    FinancialDocument?    @relation("FinancialDocumentCommitment")
  movements            CommitmentMovement[]
