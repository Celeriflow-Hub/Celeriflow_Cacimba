model HrPayrollRuleSet {
  id                      String                @id @default(cuid())
  configuracaoInstanciaId String
  configuracaoInstancia   ConfiguracaoInstancia @relation(fields: [configuracaoInstanciaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  code                    String
  name                    String
  status                  String                @default("RASCUNHO")
  scope                   String                @default("DEMONSTRACAO")
  effectiveFrom           DateTime
  effectiveUntil          DateTime?
  legalReference          String?
  notes                   String?
  isDemo                  Boolean               @default(true)
  approvedAt              DateTime?
  archivedAt              DateTime?
