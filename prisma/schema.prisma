  stockId                   String?
  stock                     MaterialStock?              @relation(fields: [stockId], references: [id], onDelete: Restrict)
  movementId                String?                     @unique
  movement                  MaterialMovement?           @relation("MedicineDispensationMovement", fields: [movementId], references: [id], onDelete: Restrict)
  dispensedByProfessionalId String?
  dispensedByProfessional   HealthProfessional?         @relation(fields: [dispensedByProfessionalId], references: [id], onDelete: Restrict)
  dosageSnapshot            String?
  observation               String?
  nextWithdrawalAt          DateTime?
  idempotencyKey            String?                     @unique
  specializedPlanId         String?
  specializedPlan           SpecializedTherapeuticPlan? @relation(fields: [specializedPlanId], references: [id], onDelete: Restrict)

