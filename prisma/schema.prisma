  priority            Int              @default(100)
  legalReference      String?
  notes               String?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  incidences HrPayrollRubricIncidence[]

  @@unique([ruleSetId, code])
  @@index([ruleSetId, type, priority])
}

model HrPayrollRubricIncidence {
  id            String          @id @default(cuid())
  rubricId      String
  rubric        HrPayrollRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade, onUpdate: Cascade)
