// SIAFIC DEMO uses immutable payload snapshots. IntegrationConnection remains
// the administrative destination configuration reused by the central console.
model SiaficEntityVersion {
  id             String                @id @default(cuid())
  connectionId   String
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  datasetId      String
  entityType     String
  entityId       String
  currentVersion Int                   @default(1)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([connectionId, datasetId, entityType, entityId])
  @@index([entityType, entityId])
}

model SiaficOutboxEvent {
  id                  String                @id @default(uuid())
  connectionId        String
  connection          IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  actorUsuarioId      String
  actorUsuario        Usuario               @relation("SiaficOutboxEventActor", fields: [actorUsuarioId], references: [id], onDelete: Restrict)
  datasetId           String
  sourceInstanceId    String
  entityType          String
  entityId            String
  entityVersion       Int
  deliveryRevision    Int                   @default(1)
  eventType           String
  operation           String
  payload             Json
  payloadHash         String
  idempotencyKey      String
  destinationSnapshot Json
  replacesEventId     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  delivery SiaficDelivery?

  @@unique([connectionId, datasetId, idempotencyKey])
  @@unique([connectionId, datasetId, entityType, entityId, entityVersion, deliveryRevision])
  @@index([connectionId, datasetId, entityType, entityId, entityVersion])
  @@index([actorUsuarioId, createdAt])
}

model SiaficDelivery {
  id             String            @id @default(cuid())
  eventId        String            @unique
  event          SiaficOutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  status         String            @default("PENDING")
  attemptCount   Int               @default(0)
  nextAttemptAt  DateTime          @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  lastError      String?
  remoteEntityId String?
  receiptId      String?
  processedAt    DateTime?
  receipt        Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  attempts SiaficDeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model SiaficDeliveryAttempt {
  id            String         @id @default(cuid())
  deliveryId    String
  delivery      SiaficDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  correlationId String
  status        String
  httpStatus    Int?
  errorCode     String?
  message       String?
  durationMs    Int?
  outcome       Json?
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?

  @@index([deliveryId, startedAt])
  @@index([correlationId])
}

model SiaficExternalLink {
  id                String                @id @default(cuid())
