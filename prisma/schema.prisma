  updatedAt          DateTime              @updatedAt
  messages           HealthDeviceMessage[]

  @@index([domain, isActive])
}

model HealthDeviceMessage {
  id             String                   @id @default(cuid())
  deviceId       String
  device         HealthAssistentialDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  direction      String
  correlationId  String
  idempotencyKey String                   @unique
  status         String
  payloadHash    String
  sanitizedData  Json?
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime                 @default(now())

  @@index([deviceId, createdAt])
  @@index([correlationId])
}

model HealthLabExamModel {
  id                  String                   @id @default(cuid())
  code                String                   @unique
  name                String
  procedureId         String?
  procedure           HealthSusProcedure?      @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  questionnaireId     String?
  questionnaire       HealthLabQuestionnaire?  @relation(fields: [questionnaireId], references: [id], onDelete: Restrict)
  bench               String?
  preparation         String?
  performedInternally Boolean                  @default(true)
  deliveryDays        Int                      @default(0)
  duplicateWindowDays Int                      @default(0)
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  orders              HealthLabOrder[]
  materials           HealthLabExamMaterial[]
  schedules           HealthLabSchedule[]
  providerQuotas      HealthLabProviderQuota[]

  @@index([isActive, name])
}

model HealthLabExamMaterial {
  id          String             @id @default(cuid())
  examModelId String
  examModel   HealthLabExamModel @relation(fields: [examModelId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity    Float              @default(1)
  warehouse   Warehouse?         @relation(fields: [warehouseId], references: [id])
  warehouseId String?

  @@unique([examModelId, materialId])
}

model HealthLabSchedule {
  id          String             @id @default(cuid())
  examModelId String
  examModel   HealthLabExamModel @relation(fields: [examModelId], references: [id], onDelete: Restrict)
  unitId      String
  unit        HealthUnit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  date        DateTime?
  weekday     Int?
  capacity    Int
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([unitId, examModelId, isActive])
}

model HealthLabProviderQuota {
  id                 String             @id @default(cuid())
  providerSupplierId String
  providerSupplier   Supplier           @relation(fields: [providerSupplierId], references: [id], onDelete: Restrict)
  unitId             String
  unit               HealthUnit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  examModelId        String
  examModel          HealthLabExamModel @relation(fields: [examModelId], references: [id], onDelete: Restrict)
  period             String
  allowedQuantity    Int
  consumedQuantity   Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([providerSupplierId, unitId, examModelId, period])
}

model HealthLabQuestionnaire {
  id             String                   @id @default(cuid())
  code           String                   @unique
  name           String
  kind           String
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  groups         HealthLabQuestionGroup[]
  examModels     HealthLabExamModel[]
}

model HealthLabQuestionGroup {
  id              String                  @id @default(cuid())
  questionnaireId String
  questionnaire   HealthLabQuestionnaire  @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  name            String
  displayOrder    Int
  pageBreak       Boolean                 @default(false)
  items           HealthLabQuestionItem[]

  @@unique([questionnaireId, displayOrder])
}

model HealthLabQuestionItem {
  id            String                 @id @default(cuid())
  groupId       String
  group         HealthLabQuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code          String
  label         String
  valueType     String
  unitOfMeasure String?
  maxLength     Int?
  calculation   String?
  options       Json?
  printOnReport Boolean                @default(true)
  displayOrder  Int
  references    Json?

  @@unique([groupId, code])
  @@unique([groupId, displayOrder])
}

model HealthLabOrder {
  id                      String                @id @default(cuid())
  examRequestId           String?               @unique
  examRequest             HealthExamRequest?    @relation(fields: [examRequestId], references: [id], onDelete: Restrict)
  examModelId             String?
  examModel               HealthLabExamModel?   @relation(fields: [examModelId], references: [id], onDelete: Restrict)
  patientId               String
  patient                 Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  requestUnitId           String?
  requestUnit             HealthUnit?           @relation("HealthLabOrderRequestUnit", fields: [requestUnitId], references: [id], onDelete: Restrict)
  collectionUnitId        String?
  collectionUnit          HealthUnit?           @relation("HealthLabOrderCollectionUnit", fields: [collectionUnitId], references: [id], onDelete: Restrict)
  collectorProfessionalId String?
  collectorProfessional   HealthProfessional?   @relation("HealthLabOrderCollector", fields: [collectorProfessionalId], references: [id], onDelete: Restrict)
  providerSupplierId      String?
  providerSupplier        Supplier?             @relation("HealthLabOrderProvider", fields: [providerSupplierId], references: [id], onDelete: Restrict)
  origin                  String                @default("ELECTRONIC_REQUEST")
  status                  String                @default("REQUESTED") // REQUESTED, SCHEDULED, COLLECTED, RECEIVED, ENTERED, REVIEWED, RELEASED, DELIVERED, RECOLLECT
  priority                String                @default("ROUTINE")
  scheduledAt             DateTime?
  collectedAt             DateTime?
  expectedResultAt        DateTime?
  sampleBarcode           String?               @unique
  collectionByThirdParty  Boolean               @default(false)
  authorizationKey        String?               @unique
  referenceValue          Float?
  idempotencyKey          String                @unique
  createdByUsuarioId      String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  results                 HealthLabResult[]
  reports                 HealthLabReport[]
  events                  HealthLabOrderEvent[]

  @@index([status, priority, createdAt])
  @@index([patientId, createdAt])
  @@index([collectionUnitId, scheduledAt])
}

model HealthLabResult {
  id                  String         @id @default(cuid())
  orderId             String
  order               HealthLabOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  version             Int
  status              String         @default("PARTIAL") // PARTIAL, FINAL, CORRECTED, CANCELLED
  source              String         @default("MANUAL") // MANUAL, DEVICE
  values              Json
  interpretation      String?
  deviceCorrelationId String?
  enteredByUsuarioId  String
  enteredAt           DateTime       @default(now())

  @@unique([orderId, version])
  @@index([deviceCorrelationId])
}

model HealthLabOrderEvent {
  id             String         @id @default(cuid())
  orderId        String
  order          HealthLabOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  eventType      String
  fromStatus     String?
  toStatus       String
  reason         String?
  actorUsuarioId String
  createdAt      DateTime       @default(now())

  @@index([orderId, createdAt])
}

model HealthLabReport {
  id                     String              @id @default(cuid())
  orderId                String
  order                  HealthLabOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  documentId             String              @unique
  document               Document            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  status                 String              @default("DRAFT") // DRAFT, REVIEWED, RELEASED, DELIVERED
  reviewerProfessionalId String?
  reviewerProfessional   HealthProfessional? @relation("HealthLabReportReviewer", fields: [reviewerProfessionalId], references: [id], onDelete: Restrict)
  reviewedAt             DateTime?
  releasedAt             DateTime?
  publishedAt            DateTime?
  deliveredAt            DateTime?
  deliveredTo            String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([orderId, status])
}

model SpecializedCatalogItem {
  id             String    @id @default(cuid())
  category       String
  code           String
  name           String
  referenceValue Float?
  materialId     String?
  material       Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([category, code])
  @@index([category, isActive, name])
}

model SpecializedTeamSchedule {
  id              String     @id @default(cuid())
  teamId          String
  team            HealthTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  unitId          String
  unit            HealthUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  month           String
  patientCapacity Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([teamId, unitId, month])
}

model SpecializedTherapeuticPlan {
  id                     String                    @id @default(cuid())
  patientId              String
  patient                Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  unitId                 String
  unit                   HealthUnit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  teamId                 String
  team                   HealthTeam                @relation(fields: [teamId], references: [id], onDelete: Restrict)
  initialMedicalRecordId String?
  initialMedicalRecord   MedicalRecord?            @relation(fields: [initialMedicalRecordId], references: [id], onDelete: Restrict)
  status                 String                    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  goals                  String
  carePlan               String
  plannedConsultations   Int
  completedConsultations Int                       @default(0)
  outcome                String?
  startedAt              DateTime                  @default(now())
  completedAt            DateTime?
  createdByUsuarioId     String
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  entries                SpecializedPlanEntry[]
  dispensations          MedicineDispensation[]
  distributions          SpecializedDistribution[]

  @@index([patientId, status, startedAt])
  @@index([teamId, status])
}

model SpecializedPlanEntry {
  id               String                     @id @default(cuid())
  planId           String
  plan             SpecializedTherapeuticPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  professionalId   String
  professional     HealthProfessional         @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  specialtyId      String?
  specialty        HealthSpecialty?           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  medicalRecordId  String?
  medicalRecord    MedicalRecord?             @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  kind             String // OPINION, EVOLUTION, INTERCONSULTATION, OUTCOME
  content          String
  diagnosisSummary String?
  weight           Float?
  height           Float?
  bmi              Float?
  createdAt        DateTime                   @default(now())
  healthService    HealthService?             @relation(fields: [healthServiceId], references: [id])
  healthServiceId  String?

  @@index([planId, createdAt])
  @@index([professionalId, createdAt])
}

model SpecializedQuota {
  id               String                    @id @default(cuid())
  patientId        String
  patient          Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  materialId       String
  material         Material                  @relation(fields: [materialId], references: [id], onDelete: Restrict)
  period           String
  allowedQuantity  Float
  consumedQuantity Float                     @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  distributions    SpecializedDistribution[]

  @@unique([patientId, materialId, period])
}

model SpecializedDistribution {
  id                   String                     @id @default(cuid())
  planId               String
  plan                 SpecializedTherapeuticPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotaId              String?
  quota                SpecializedQuota?          @relation(fields: [quotaId], references: [id], onDelete: Restrict)
  patientId            String
  patient              Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  warehouseId          String
  warehouse            Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  materialId           String
  material             Material                   @relation(fields: [materialId], references: [id], onDelete: Restrict)
  stockId              String
  stock                MaterialStock              @relation(fields: [stockId], references: [id], onDelete: Restrict)
  movementId           String                     @unique
  movement             MaterialMovement           @relation("SpecializedDistributionMovement", fields: [movementId], references: [id], onDelete: Restrict)
  quantity             Float
  referenceValue       Float?
  deliveredByUsuarioId String
  deliveredAt          DateTime                   @default(now())
  notes                String?

  @@index([patientId, deliveredAt])
  @@index([planId, deliveredAt])
}

// --- S4: Regulacao, Cotas, TFD e Transporte ---
model HealthRegulationQuota {
  id                 String              @id @default(cuid())
  providerSupplierId String
  provider           Supplier            @relation(fields: [providerSupplierId], references: [id], onDelete: Restrict)
  unitId             String?
  unit               HealthUnit?         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  specialtyId        String?
  specialty          HealthSpecialty?    @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  serviceId          String?
  service            HealthService?      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  procedureId        String?
  procedure          HealthSusProcedure? @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  period             String // YYYY-MM
  totalQuantity      Int
  reservedQuantity   Int                 @default(0)
  realizedQuantity   Int                 @default(0)
  unitValue          Decimal?            @db.Decimal(14, 2)
  convenioId         String?
  convenio           Covenant?           @relation(fields: [convenioId], references: [id], onDelete: Restrict)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  requests HealthRegulationRequest[]

  @@index([providerSupplierId, period])
  @@index([unitId, period])
  @@index([period, isActive])
}

model HealthRegulationRequest {
  id                 String                  @id @default(cuid())
  patientId          String
  patient            Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  requestUnitId      String?
  requestUnit        HealthUnit?             @relation(fields: [requestUnitId], references: [id], onDelete: Restrict)
  professionalId     String?
  professional       HealthProfessional?     @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  specialtyId        String?
  specialty          HealthSpecialty?        @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  serviceId          String?
  service            HealthService?          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  procedureId        String?
  procedure          HealthSusProcedure?     @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  priority           String                  @default("Normal") // Alta, Media, Normal
  status             String                  @default("RECEBIDA") // RECEBIDA, EM_ANALISE, AUTORIZADA, AGENDADA, EXECUTADA, DEVOLVIDA, CANCELADA, ARQUIVADA, CONCLUIDA
  origin             String                  @default("DIRECT") // PEP_REFERRAL, PEP_EXAM, DIRECT
  referralId         String?                 @unique
  referral           HealthReferral?         @relation(fields: [referralId], references: [id], onDelete: Restrict)
  examRequestId      String?                 @unique
  examRequest        HealthExamRequest?      @relation(fields: [examRequestId], references: [id], onDelete: Restrict)
  description        String?
  quotaId            String?
  quota              HealthRegulationQuota?  @relation(fields: [quotaId], references: [id], onDelete: Restrict)
  sectorId           String?
  sector             HealthRegulationSector? @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  protocolNumber     String?                 @unique
  validationCode     String?                 @unique
  cidReferenceId     String?
  cidReference       HealthSusReference?     @relation(fields: [cidReferenceId], references: [id], onDelete: Restrict)
  patientCondition   String?
  executorNotes      String?
  transportNotes     String?
  isExternal         Boolean                 @default(false)
  observations       String?
  preparation        String?
  contactPhone       String?
  feedback           String?
  guideNumber        String?                 @unique
  guideIssuedAt      DateTime?
  guideDocumentId    String?
  guideDocument      Document?               @relation(fields: [guideDocumentId], references: [id], onDelete: Restrict)
  scheduledAt        DateTime?
  executedAt         DateTime?
  returnedAt         DateTime?
  createdByUsuarioId String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  events      HealthRegulationEvent[]
  tfdRequests HealthTfdRequest[]
  attachments HealthRegulationAttachment[]

  @@index([status, priority, createdAt])
  @@index([patientId, status])
  @@index([requestUnitId, status])
  @@index([quotaId])
  @@index([sectorId, status])
}

model HealthRegulationEvent {
  id             String                  @id @default(cuid())
  requestId      String
  request        HealthRegulationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus     String
  toStatus       String
  eventType      String
  notes          String?
  actorUsuarioId String
  createdAt      DateTime                @default(now())

  @@index([requestId, createdAt])
}

model HealthTfdRequest {
  id                  String                   @id @default(cuid())
  patientId           String
  patient             Patient                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  regulationRequestId String?
  regulationRequest   HealthRegulationRequest? @relation(fields: [regulationRequestId], references: [id], onDelete: Restrict)
  originUnitId        String?
  originUnit          HealthUnit?              @relation(fields: [originUnitId], references: [id], onDelete: Restrict)
  destination         String
  reason              String
  priority            String                   @default("Normal")
  status              String                   @default("SOLICITADA") // SOLICITADA, AUTORIZADA, AGENDADA, EM_TRANSITO, CONCLUIDA, CANCELADA
  companionName       String?
  companionDocument   String?
  authorizedAt        DateTime?
  createdByUsuarioId  String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  passengers HealthTfdPassenger[]

  @@index([status, createdAt])
  @@index([patientId, status])
}

model HealthTfdTrip {
  id                 String    @id @default(cuid())
  date               DateTime  @db.Date
  origin             String
  destination        String
  fleetUnitId        String
  fleetUnit          FleetUnit @relation(fields: [fleetUnitId], references: [id], onDelete: Restrict)
  driverEmployeeId   String?
  driverEmployee     Employee? @relation(fields: [driverEmployeeId], references: [id], onDelete: Restrict)
  capacity           Int
  status             String    @default("PLANEJADA") // PLANEJADA, EMBARCANDO, EM_TRANSITO, RETORNANDO, CONCLUIDA, CANCELADA
  departureAt        DateTime?
  returnAt           DateTime?
  createdByUsuarioId String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  passengers HealthTfdPassenger[]

  @@index([date, status])
  @@index([fleetUnitId, date])
}

model HealthTfdPassenger {
  id                        String                     @id @default(cuid())
  tripId                    String
  trip                      HealthTfdTrip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  patientId                 String
  patient                   Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  tfdRequestId              String?
  tfdRequest                HealthTfdRequest?          @relation(fields: [tfdRequestId], references: [id], onDelete: Restrict)
  companionName             String?
  companionDocument         String?
  kind                      String                     @default("PACIENTE") // PACIENTE, ACOMPANHANTE
  createdAt                 DateTime                   @default(now())
  healthTfdPassengerRemoval HealthTfdPassengerRemoval?

  @@unique([tripId, patientId, kind])
  @@index([patientId])
}

// --- S4-C: Producao e Faturamento SUS ---
model HealthProductionCompetence {
  id                 String    @id @default(cuid())
  period             String    @unique // YYYY-MM
  status             String    @default("ABERTA") // ABERTA, PROCESSADA, FECHADA
  openedAt           DateTime  @default(now())
  processedAt        DateTime?
  closedAt           DateTime?
  createdByUsuarioId String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  facts                   HealthProductionFact[]
  files                   HealthSusFile[]
  healthProductionTargets HealthProductionTarget[]

  @@index([status])
}

model HealthProductionFact {
  id             String                      @id @default(cuid())
  originType     String // PEP_PROCEDURE, LAB_RESULT, VACCINATION, REGULATION
  originId       String
  patientId      String?
  patient        Patient?                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  unitId         String?
  unit           HealthUnit?                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  professionalId String?
  professional   HealthProfessional?         @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  procedureId    String?
  procedure      HealthSusProcedure?         @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  quantity       Int                         @default(1)
  value          Decimal?                    @db.Decimal(14, 2)
  cidReferenceId String?
  cidReference   HealthSusReference?         @relation(fields: [cidReferenceId], references: [id], onDelete: Restrict)
  municipality   String? // Snapshot histórico do atendimento; não acompanha o endereço atual
  state          String? // Snapshot histórico do atendimento; não acompanha o endereço atual
  occurredAt     DateTime
  period         String // YYYY-MM
  competenceId   String?
  competence     HealthProductionCompetence? @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  status         String                      @default("VALIDO") // VALIDO, CRITICADO
  idempotencyKey String                      @unique
  createdAt      DateTime                    @default(now())

  criticisms HealthProductionCriticism[]

  @@index([period, status])
  @@index([competenceId, status])
  @@index([unitId, period])
  @@index([cidReferenceId])
  @@index([municipality, state])
}

model HealthProductionCriticism {
  id           String               @id @default(cuid())
  factId       String
  fact         HealthProductionFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  code         String
  message      String
  actionNeeded String?
  status       String               @default("ABERTA") // ABERTA, RESOLVIDA
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())

  @@index([factId, status])
}

model HealthSusFile {
  id                 String                     @id @default(cuid())
  fileType           String // BPA, FPO, RAAS, AIH, OUTRO
  competenceId       String
  competence         HealthProductionCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  unitId             String?
  unit               HealthUnit?                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  content            String
  hash               String
  quantity           Int
  totalValue         Decimal?                   @db.Decimal(14, 2)
  status             String                     @default("GERADO") // GERADO, PROCESSADO, PARCIAL, REJEITADO
  processedCount     Int                        @default(0)
  rejectedCount      Int                        @default(0)
  errors             Json?
  processedAt        DateTime?
  createdByUsuarioId String
  createdAt          DateTime                   @default(now())

  @@index([competenceId, fileType])
}

// --- Correção final POC B4: metas FPO e teto por unidade ---
model HealthProductionTarget {
  id                 String                     @id @default(cuid())
  competenceId       String
  competence         HealthProductionCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  procedureId        String
  procedure          HealthSusProcedure         @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  contractedQuantity Float
  createdByUsuarioId String
  createdAt          DateTime                   @default(now())

  @@unique([competenceId, procedureId])
}

model HealthUnitCeiling {
  id                 String     @id @default(cuid())
  unitId             String
  unit               HealthUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  period             String // YYYY-MM
  value              Decimal    @db.Decimal(14, 2)
  createdByUsuarioId String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([unitId, period])
}

// --- Correção final POC B5: PA (recepção, risco configurável, leitos) ---
model HealthRiskProtocol {
  id             String   @id @default(cuid())
  level          Int      @unique // 1 (mais urgente) a 5
  label          String
  colorHex       String   @default("#64748b")
  maxWaitMinutes Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HealthDestination {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  receptions HealthReception[]
}

model HealthRoom {
  id        String     @id @default(cuid())
  unitId    String
  unit      HealthUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  name      String
  kind      String     @default("Atendimento") // Atendimento, Triagem
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  receptions HealthReception[]

  @@unique([unitId, name])
}

model HealthReception {
  id                 String             @id @default(cuid())
  patientId          String?
  patient            Patient?           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  unidentifiedName   String?
  unitId             String
  unit               HealthUnit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  arrivalAt          DateTime           @default(now())
  priorityFlags      String? // GESTANTE, IDOSO, DEFICIENTE (vírgula)
  companionName      String?
  companionKinship   String?
  companionPhone     String?
  transportMode      String? // Meios próprios, Socorro
  agreement          String?
  roomId             String?
  room               HealthRoom?        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  destinationId      String?
  destination        HealthDestination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  status             String             @default("Aguardando") // Aguardando, Em atendimento, Concluída, Evadiu-se, Cancelada
  outcome            String?
  createdByUsuarioId String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([unitId, status, arrivalAt])
  @@index([patientId])
}

model HealthBed {
  id        String     @id @default(cuid())
  unitId    String
  unit      HealthUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  room      String?
  code      String
  status    String     @default("Livre") // Livre, Ocupado, Manutenção, Reservado, Limpeza
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  occupancies        HealthBedOccupancy[]
  healthObservations HealthObservation[]

  @@unique([unitId, code])
  @@index([unitId, status])
}

model HealthBedOccupancy {
  id           String    @id @default(cuid())
  bedId        String
  bed          HealthBed @relation(fields: [bedId], references: [id], onDelete: Restrict)
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  admittedAt   DateTime  @default(now())
  dischargedAt DateTime?
  notes        String?

  @@index([bedId, dischargedAt])
  @@index([patientId])
}

model HealthObservation {
  id                 String     @id @default(cuid())
  patientId          String
  patient            Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  unitId             String
  unit               HealthUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  bedId              String?
  bed                HealthBed? @relation(fields: [bedId], references: [id], onDelete: Restrict)
  responsible        String?
  solicitedBy        String?
  status             String     @default("Em observação") // Em observação, Alta, Transferido
  admittedAt         DateTime   @default(now())
  dischargedAt       DateTime?
  createdByUsuarioId String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([unitId, status])
}

// --- Correção final POC B6: regulação (setores, protocolo, anexos, convênios) ---
model HealthRegulationSector {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  requests HealthRegulationRequest[]
}

model HealthRegulationAttachment {
  id                  String                  @id @default(cuid())
  requestId           String
  request             HealthRegulationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentId          String
  document            Document                @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedByUsuarioId String
  createdAt           DateTime                @default(now())

  @@index([requestId])
}

model HealthTfdPassengerRemoval {
  id                   String             @id @default(cuid())
  passengerId          String             @unique
  passenger            HealthTfdPassenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  requestedByUsuarioId String
  confirmedByUsuarioId String?
  status               String             @default("Pendente") // Pendente, Confirmada, Cancelada
  createdAt            DateTime           @default(now())
}

// --- S4-D: Territorio, SISAB e e-SUS ---
model HealthTerritoryArea {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  unitId    String?
  unit      HealthUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  teamId    String?
  team      HealthTeam? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  microareas HealthMicroarea[]
  visits     HealthHomeVisit[]

  @@index([unitId, isActive])
}

model HealthMicroarea {
  id                  String              @id @default(cuid())
  code                String
  areaId              String
  area                HealthTerritoryArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  agentProfessionalId String?
  agentProfessional   HealthProfessional? @relation(fields: [agentProfessionalId], references: [id], onDelete: Restrict)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())

  households HealthHousehold[]
  visits     HealthHomeVisit[]

  @@unique([areaId, code])
}

model HealthHousehold {
  id            String           @id @default(cuid())
  householdCode String?          @unique
  microareaId   String?
  microarea     HealthMicroarea? @relation(fields: [microareaId], references: [id], onDelete: Restrict)
  addressId     String?
  address       Address?         @relation(fields: [addressId], references: [id], onDelete: Restrict)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  families HealthFamily[]
  visits   HealthHomeVisit[]
  forms    HealthEsusForm[]
}

model HealthFamily {
  id                  String           @id @default(cuid())
  familyCode          String?
  householdId         String?
  household           HealthHousehold? @relation(fields: [householdId], references: [id], onDelete: Restrict)
  responsiblePersonId String?
  responsiblePerson   Person?          @relation(fields: [responsiblePersonId], references: [id], onDelete: Restrict)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  members HealthFamilyMember[]
  visits  HealthHomeVisit[]
  forms   HealthEsusForm[]

  @@index([householdId, isActive])
}

model HealthFamilyMember {
  id        String       @id @default(cuid())
  familyId  String
  family    HealthFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  personId  String       @unique
  person    Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  kinship   String?
  createdAt DateTime     @default(now())

  @@index([familyId])
}

model HealthHomeVisit {
  id                 String               @id @default(cuid())
  householdId        String?
  household          HealthHousehold?     @relation(fields: [householdId], references: [id], onDelete: Restrict)
  familyId           String?
  family             HealthFamily?        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  teamId             String?
  team               HealthTeam?          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  professionalId     String
  professional       HealthProfessional   @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  areaId             String?
  area               HealthTerritoryArea? @relation(fields: [areaId], references: [id], onDelete: Restrict)
  microareaId        String?
  microarea          HealthMicroarea?     @relation(fields: [microareaId], references: [id], onDelete: Restrict)
  visitedAt          DateTime
  actions            String
  observations       String?
  status             String               @default("REALIZADA") // REALIZADA, CANCELADA
  createdByUsuarioId String
  createdAt          DateTime             @default(now())

  participants HealthHomeVisitParticipant[]

  @@index([visitedAt, status])
  @@index([familyId, visitedAt])
}

model HealthHomeVisitParticipant {
  id        String          @id @default(cuid())
  visitId   String
  visit     HealthHomeVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  personId  String
  person    Person          @relation(fields: [personId], references: [id], onDelete: Restrict)
  patientId String?
  patient   Patient?        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdAt DateTime        @default(now())

  @@unique([visitId, personId])
}

model HealthEsusForm {
  id                    String              @id @default(cuid())
  kind                  String // INDIVIDUAL, DOMICILIAR, VISITA, ATENDIMENTO_INDIVIDUAL, ODONTO, ATIVIDADE_COLETIVA, PROCEDIMENTOS, CONSUMO_ALIMENTAR, ATENDIMENTO_DOMICILIAR, OUTRO
  householdId           String?
  household             HealthHousehold?    @relation(fields: [householdId], references: [id], onDelete: Restrict)
  familyId              String?
  family                HealthFamily?       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  personId              String?
  person                Person?             @relation(fields: [personId], references: [id], onDelete: Restrict)
  patientId             String?
  patient               Patient?            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professionalId        String?
  professional          HealthProfessional? @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  teamId                String?
  team                  HealthTeam?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  unitId                String?
  unit                  HealthUnit?         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  period                String // YYYY-MM
  status                String              @default("RASCUNHO") // RASCUNHO, FINALIZADA
  payload               Json?
  originMedicalRecordId String?
  originMedicalRecord   MedicalRecord?      @relation(fields: [originMedicalRecordId], references: [id], onDelete: Restrict)
  idempotencyKey        String              @unique
  finalizedAt           DateTime?
  createdByUsuarioId    String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  batchItems HealthEsusBatchItem[]

  @@index([kind, period, status])
  @@index([unitId, period])
}

model HealthEsusBatch {
  id                 String    @id @default(cuid())
  competence         String // YYYY-MM
  status             String    @default("GERADO") // GERADO, PROCESSANDO, ACEITO, PARCIAL, REJEITADO
  fileContent        String
  hash               String
  total              Int
  accepted           Int       @default(0)
  rejected           Int       @default(0)
  errors             Json?
  processedAt        DateTime?
  createdByUsuarioId String
  createdAt          DateTime  @default(now())

  items HealthEsusBatchItem[]

  @@index([competence, status])
}

model HealthEsusBatchItem {
  id        String          @id @default(cuid())
  batchId   String
  batch     HealthEsusBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  formId    String
  form      HealthEsusForm  @relation(fields: [formId], references: [id], onDelete: Restrict)
  status    String          @default("PENDENTE") // PENDENTE, ACEITO, REJEITADO
  message   String?
  createdAt DateTime        @default(now())

  @@unique([batchId, formId])
}

// --- Correção final POC: Agenda (cronogramas, vagas, espera) ---
model HealthCareSchedule {
  id                 String                 @id @default(cuid())
  kind               String                 @default("FIXO") // FIXO, DIARIO
  unitId             String
  unit               HealthUnit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  specialtyId        String?
  specialty          HealthSpecialty?       @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  professionalId     String?
  professional       HealthProfessional?    @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  groupId            String?
  group              HealthSchedulingGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  providerSupplierId String?
  provider           Supplier?              @relation(fields: [providerSupplierId], references: [id], onDelete: Restrict)
  weekday            Int?
  date               DateTime?              @db.Date
  startTime          String?
  endTime            String?
  totalSlots         Int                    @default(1)
  status             String                 @default("Ativo") // Ativo, Bloqueado, Cancelado
  blockReason        String?
  createdByUsuarioId String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  appointments HealthAppointment[]
  waitlist     HealthWaitlist[]

  @@index([unitId, status])
  @@index([professionalId, date])
  @@index([kind, status])
}

model HealthWaitlist {
  id                 String              @id @default(cuid())
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  specialtyId        String?
  specialty          HealthSpecialty?    @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  scheduleId         String?
  schedule           HealthCareSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  priority           String              @default("Normal") // Normal, Prioridade, Urgência
  status             String              @default("Aguardando") // Aguardando, Chamado, Convertido, Cancelado
  notes              String?
  createdByUsuarioId String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, priority, createdAt])
  @@index([patientId, status])
}

// --- S5: Portal do Prestador e Vigilância em Saúde ---
model HealthProviderAccess {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, usuarioId])
  @@index([usuarioId, isActive])
}

model HealthVigilanceEstablishment {
  id        String   @id @default(cuid())
  name      String
  document  String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Restrict)
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: Restrict)
  cnae      String?
  activity  String?
  riskLevel String? // Classificação de risco configurada; nunca inferida automaticamente
  status    String   @default("Ativo") // Ativo, Inativo, Interditado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints  HealthVigilanceComplaint[]
  inspections HealthVigilanceInspection[]
  licenses    HealthVigilanceLicense[]

  @@index([status])
  @@index([cnae])
}

model HealthVigilanceComplaint {
  id               String                        @id @default(cuid())
  establishmentId  String?
  establishment    HealthVigilanceEstablishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  place            String?
  description      String
  isAnonymous      Boolean                       @default(true)
  reporterPersonId String?
  reporterPerson   Person?                       @relation(fields: [reporterPersonId], references: [id], onDelete: Restrict)
  status           String                        @default("Recebida") // Recebida, Em apuração, Encerrada
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  inspections HealthVigilanceInspection[]

  @@index([status, createdAt])
}

model HealthVigilanceInspection {
  id                 String                       @id @default(cuid())
  establishmentId    String
  establishment      HealthVigilanceEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  complaintId        String?
  complaint          HealthVigilanceComplaint?    @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  professionalId     String?
  professional       HealthProfessional?          @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  inspectedAt        DateTime
  reason             String?
  findings           String?
  status             String                       @default("Agendada") // Agendada, Realizada, Com pendências, Encerrada
  createdByUsuarioId String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  items HealthVigilanceInspectionItem[]

  @@index([establishmentId, inspectedAt])
  @@index([status])
}

model HealthVigilanceInspectionItem {
  id           String                    @id @default(cuid())
  inspectionId String
  inspection   HealthVigilanceInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  description  String
  result       String                    @default("Não avaliado") // Conforme, Não conforme, Não avaliado
  notes        String?
}

model HealthVigilanceLicense {
  id                String                       @id @default(cuid())
  establishmentId   String
  establishment     HealthVigilanceEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  licenseNumber     String                       @unique
  validFrom         DateTime                     @db.Date
  validUntil        DateTime                     @db.Date
  status            String                       @default("Válido") // Válido, Vencido, Suspenso, Cancelado
  documentId        String?
  document          Document?                    @relation(fields: [documentId], references: [id], onDelete: Restrict)
  issuedByUsuarioId String
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([status, validUntil])
}

// --- Modulo 14: Assistencia Social ---

model SocialUnit {
  id       String  @id @default(cuid())
  name     String
  type     String // CRAS, CREAS, Centro POP, Acolhimento
  phone    String?
  email    String?
  isActive Boolean @default(true)

  addressId String?  @unique
  address   Address? @relation("SocialUnitAddress", fields: [addressId], references: [id])

  realEstateId String?
  realEstate   RealEstate? @relation(fields: [realEstateId], references: [id])

  managerId String?
  manager   Employee? @relation("SocialUnitManager", fields: [managerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances SocialAttendance[]
  records     SocialRecord[]
}

model SocialFamily {
  id              String  @id @default(cuid())
  familyCode      String? @unique // CÃ³digo Familiar CadÃšnico
  nis             String?
  income          Float? // Renda Familiar
  perCapitaIncome Float?
  vulnerabilities String? // Principais vulnerabilidades identificadas
  status          String  @default("Ativo") // Ativo, Inativo

  representativeId String @unique
  representative   Person @relation("FamilyRepresentative", fields: [representativeId], references: [id])

  addressId String?
  address   Address? @relation("FamilyAddress", fields: [addressId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

