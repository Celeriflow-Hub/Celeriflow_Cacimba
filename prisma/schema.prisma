// Frotas: domínio operacional independente de Obras e Patrimônio.
// Patrimônio e Almoxarifado compartilham referências reais e projeções transacionais.
model FleetUnit {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  category          String
  status            String             @default("ATIVO")
  operationalStatus String             @default("ATIVO")
  patrimonyStatus   String?
  plate             String?            @unique
  renavam           String?
  brand             String?
  model             String?
  year              Int?
  notes             String?
  departmentId      String?
  assetId           String?            @unique
  asset             Asset?             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  responsibleId     String?
  parentId          String?
  parent            FleetUnit?         @relation("FleetAggregate", fields: [parentId], references: [id], onDelete: Restrict)
  aggregates        FleetUnit[]        @relation("FleetAggregate")
  usages            FleetUsage[]
  plans             FleetPlan[]
  orders            FleetWorkOrder[]
  consumptions      FleetConsumption[]
  expenses          FleetExpense[]
  documents         FleetDocument[]
  occurrences       FleetOccurrence[]
  assetEvents       FleetAssetEvent[]
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  educationTransportRoutes   EducationTransportRoute[]
  educationTransportJourneys EducationTransportJourney[]
  healthTfdTrips             HealthTfdTrip[]

  @@index([departmentId, category, status, code])
}

model FleetRoute {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  origin       String
  destination  String
  itinerary    String
