  sourceModule    String              @default("MANUAL")
  sourceType      String              @default("BUDGET_MOVEMENT")
  sourceId        String?
  eventType       String              @default("BUDGET_MOVEMENT")
  idempotencyKey  String?             @unique
  createdAt       DateTime            @default(now())
}

model Creditor {
