  quantity           Float?
  cost               Float    @default(0)
  description        String
  supplierName       String?
  evidenceDocumentId String?
  status             String   @default("REGISTRADO")
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([assetId, occurredAt])
  @@index([type, occurredAt])
