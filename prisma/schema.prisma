  reference String
  status    String    @default("ABERTO") // ABERTO, CONCLUIDO, CANCELADO
  dueAt     DateTime?
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  findings InternalControlFinding[]

  @@index([status, dueAt])
}

model InternalControlFinding {
  id                 String              @id @default(cuid())
  planId             String
  plan               InternalControlPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title              String
  description        String
  status             String              @default("PENDENTE") // PENDENTE, EM_TRATAMENTO, RESOLVIDO
