{
  "name": "celeriflow",
  "version": "1.235.0",
  "private": true,
  "scripts": {
    "version:bump": "node scripts/bump-version.mjs",
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node scripts/run-group-a-tests.mjs",
    "seed:poc": "npx tsx prisma/seed-poc-massivo.ts",
    "seed:poc-base": "npx tsx prisma/seed-poc-completo.ts",
    "seed:excel-demo": "npx tsx scripts/seed-excel-demo.ts",
    "seed:excel-demo:validate": "npx tsx scripts/seed-excel-demo.ts --validate-only",
    "seed:excel-demo:test-local": "npx tsx scripts/verify-excel-demo-seed-local.ts",
    "seed:operational-demo": "npx tsx scripts/seed-operational-demo.ts",
    "seed:education-s1": "npx tsx scripts/seed-education-s1.ts",
    "seed:education-s2": "npx tsx scripts/seed-education-s2.ts",
    "seed:education-s3": "npx tsx scripts/seed-education-s3.ts",
    "seed:education-s4": "npx tsx scripts/seed-education-s4.ts",
    "seed:education-s5": "npx tsx scripts/seed-education-s5.ts",
    "health:catalogs:import": "npx tsx scripts/import-health-care-catalogs.ts",
    "health:s3:verify": "npx tsx scripts/verify-health-s3.ts",
    "health:s4ab:verify": "npx tsx scripts/verify-s4-ab.ts",
    "health:s4cd:verify": "npx tsx scripts/verify-s4-cd.ts",
    "health:s4final:verify": "npx tsx --conditions=react-server scripts/verify-s4-final.ts",
    "health:s5:verify": "npx tsx scripts/verify-s5.ts",
    "seed:poc-bank-sandbox": "npx tsx scripts/provision-bank-sandbox-poc.ts",
    "provision:poc-financial-demo": "npx tsx scripts/provision-financial-demo-poc.ts",
    "sync:poc-bank-payments": "npx tsx scripts/sync-poc-bank-payment-orders.ts",
    "sync:poc-virtual-bank": "npx tsx scripts/sync-poc-virtual-bank.ts",
    "backfill:poc-bank-statements": "npx tsx scripts/backfill-poc-bank-statement-accounts.ts",
    "provision:poc-evaluators": "npx tsx scripts/provision-poc-evaluators.ts",
    "seed:firebase": "npx tsx scripts/seed-firebase-users.ts",
    "provision:citizens": "npx tsx scripts/provision-citizen-test-users.ts",
    "seed:all": "npm run seed:poc && npm run seed:firebase",
    "verify:poc-users": "node scripts/verify-poc-users.mjs",
    "verify:poc-base": "npx tsx scripts/verify-poc-base.ts",
    "verify:group-a-evidence": "node scripts/verify-group-a-evidence.mjs",
    "finance:decimal:reconcile": "node scripts/finance-decimal-reconcile.mjs",
    "finance:decimal:backfill": "node scripts/finance-decimal-reconcile.mjs --backfill",
    "finance:treasury:opening-backfill": "node scripts/finance-treasury-opening-backfill.mjs",
    "finance:creditor:backfill": "node scripts/finance-creditor-backfill.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "bootstrap:test-db": "node scripts/bootstrap-test-database.mjs",
    "reset:firebase-password": "node scripts/reset-firebase-password.mjs",
    "siafic:validate-config": "node --conditions=react-server --import tsx scripts/validate-siafic-config.ts",
    "siafic:prepare-demo": "node --conditions=react-server --import tsx scripts/prepare-siafic-demo.ts",
    "siafic:worker": "node scripts/run-siafic-worker.mjs",
    "siafic:reconcile": "node --conditions=react-server --import tsx scripts/reconcile-siafic.ts",
    "test:siafic": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/siafic.migration.test.ts tests/siafic.integration.test.ts",
    "test:siafic:e2e": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/siafic.e2e.test.ts",
    "postinstall": "prisma generate",
    "test:frotas": "node scripts/run-fleet-tests.mjs",
    "test:education-s1": "node --import tsx --test tests/education-s1.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/ws": "^8.18.1",
    "@vercel/blob": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "pdfkit": "^0.17.2",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@prisma/adapter-pg": "7.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}
